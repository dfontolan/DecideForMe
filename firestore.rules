rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID, including anonymous/guest, Google Sign-In, & username/password)
    // Formats:
    //   1. Encrypted client-side state format:
    //      - payload: string (required, 1..1048576 bytes) - encrypted DecideForMe app state
    //      - iv: string (required, 1..128 bytes) - initialization vector
    //      - v: int (required, == 1) - encryption schema version
    //      - updatedAt: timestamp (required) - last sync timestamp
    //      - accountType: string (optional, 'guest' | 'google' | 'username') - authentication provider type
    //      - swCacheVersion: string (optional, 1..64 bytes) - active service worker cache version
    //   2. Legacy plaintext state format (backwards compatibility):
    //      - state: map (required, max 50 top-level keys) - serialized DecideForMe app state
    //      - updatedAt: timestamp (required) - last sync timestamp
    //      - accountType: string (optional, 'guest' | 'google' | 'username') - authentication provider type
    //      - swCacheVersion: string (optional, 1..64 bytes) - active service worker cache version
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (covers Google Sign-In and Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the document by document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check that the user is signed in with a non-guest provider (Google or Username)
    function isNonGuest() {
      return isAuthenticated() &&
             request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Deterministic friendship document ID for two UIDs
    function friendshipPairId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    // Check if the caller and otherUid have an accepted friendship
    function isAcceptedFriend(otherUid) {
      let pairId = friendshipPairId(request.auth.uid, otherUid);
      return exists(/databases/$(database)/documents/friendships/$(pairId)) &&
             get(/databases/$(database)/documents/friendships/$(pairId)).data.status == 'accepted';
    }

    // Validate that all required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function hasValidCommonUserFields(data) {
      return data.updatedAt is timestamp &&
             (!('accountType' in data) || (data.accountType is string && data.accountType in ['guest', 'google', 'username'])) &&
             (!('swCacheVersion' in data) || (data.swCacheVersion is string && data.swCacheVersion.size() > 0 && data.swCacheVersion.size() <= 64));
    }

    function isValidEncryptedUserState(data) {
      return hasOnlyAllowedFields(['payload', 'iv', 'v', 'updatedAt', 'accountType', 'swCacheVersion']) &&
             hasRequiredFields(['payload', 'iv', 'v', 'updatedAt']) &&
             data.payload is string &&
             data.payload.size() > 0 &&
             data.payload.size() <= 1048576 &&
             data.iv is string &&
             data.iv.size() > 0 &&
             data.iv.size() <= 128 &&
             data.v is int &&
             data.v == 1 &&
             hasValidCommonUserFields(data);
    }

    function isValidLegacyUserState(data) {
      return hasOnlyAllowedFields(['state', 'updatedAt', 'accountType', 'swCacheVersion']) &&
             hasRequiredFields(['state', 'updatedAt']) &&
             data.state is map &&
             data.state.keys().size() <= 50 &&
             hasValidCommonUserFields(data);
    }

    function isValidUserState(data) {
      return isValidEncryptedUserState(data) || isValidLegacyUserState(data);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserState(request.resource.data);
      allow update: if isOwner(userId) && isValidUserState(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // 6-digit friend code lookup (get by exact code only; no listing)
    match /friendCodes/{code} {
      allow get: if isNonGuest();
      allow list: if false;
      allow create: if isNonGuest() &&
                       code.matches('^[0-9]{6}$') &&
                       hasOnlyAllowedFields(['uid', 'displayName', 'createdAt']) &&
                       hasRequiredFields(['uid', 'displayName', 'createdAt']) &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.displayName is string &&
                       request.resource.data.displayName.size() >= 1 &&
                       request.resource.data.displayName.size() <= 24 &&
                       request.resource.data.createdAt is timestamp;
      allow update: if isNonGuest() &&
                       resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == request.auth.uid &&
                       hasOnlyAllowedFields(['uid', 'displayName', 'createdAt']) &&
                       hasRequiredFields(['uid', 'displayName', 'createdAt']) &&
                       request.resource.data.displayName is string &&
                       request.resource.data.displayName.size() >= 1 &&
                       request.resource.data.displayName.size() <= 24;
      allow delete: if isNonGuest() && resource.data.uid == request.auth.uid;
    }

    // Owner-only social profile (stores own 6-digit code & nickname)
    match /socialProfiles/{userId} {
      allow read: if isOwner(userId) && isNonGuest();
      allow create, update: if isOwner(userId) &&
                               isNonGuest() &&
                               hasOnlyAllowedFields(['code', 'displayName', 'updatedAt']) &&
                               hasRequiredFields(['code', 'displayName', 'updatedAt']) &&
                               request.resource.data.code is string &&
                               request.resource.data.code.matches('^[0-9]{6}$') &&
                               request.resource.data.displayName is string &&
                               request.resource.data.displayName.size() >= 1 &&
                               request.resource.data.displayName.size() <= 24 &&
                               request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId) && isNonGuest();
    }

    // Friendships & pending friend requests
    match /friendships/{pairId} {
      allow get: if isNonGuest() && (resource == null || (request.auth.uid in resource.data.users));
      allow list: if isNonGuest() && (request.auth.uid in resource.data.users);
      allow create: if isNonGuest() &&
                       hasOnlyAllowedFields(['users', 'status', 'requestedBy', 'names', 'createdAt', 'updatedAt']) &&
                       hasRequiredFields(['users', 'status', 'requestedBy', 'names', 'createdAt', 'updatedAt']) &&
                       request.resource.data.users is list &&
                       request.resource.data.users.size() == 2 &&
                       request.resource.data.users[0] is string &&
                       request.resource.data.users[1] is string &&
                       request.resource.data.users[0] < request.resource.data.users[1] &&
                       pairId == request.resource.data.users[0] + '_' + request.resource.data.users[1] &&
                       request.auth.uid in request.resource.data.users &&
                       request.resource.data.requestedBy == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.names is map;
      allow update: if isNonGuest() &&
                       (request.auth.uid in resource.data.users) &&
                       hasOnlyAllowedFields(['users', 'status', 'requestedBy', 'names', 'createdAt', 'updatedAt']) &&
                       request.resource.data.users == resource.data.users &&
                       request.resource.data.requestedBy == resource.data.requestedBy &&
                       ((resource.data.status == 'pending' &&
                         request.resource.data.status == 'accepted' &&
                         request.auth.uid != resource.data.requestedBy) ||
                        (resource.data.status == request.resource.data.status));
      allow delete: if isNonGuest() && (request.auth.uid in resource.data.users);
    }

    // Daily star tier & streak summary (readable only by owner or accepted friends)
    match /dailyStatus/{userId} {
      allow read: if isNonGuest() && (isOwner(userId) || ('friendUids' in resource.data && request.auth.uid in resource.data.friendUids) || (!('friendUids' in resource.data) && isAcceptedFriend(userId)));
      allow create, update: if isOwner(userId) &&
                               isNonGuest() &&
                               hasOnlyAllowedFields(['lastStarDate', 'lastStarTier', 'streak', 'streakDate', 'code', 'friendUids', 'updatedAt']) &&
                               hasRequiredFields(['streak', 'streakDate', 'updatedAt']) &&
                               (!('lastStarDate' in request.resource.data) || request.resource.data.lastStarDate is string) &&
                               (!('lastStarTier' in request.resource.data) || request.resource.data.lastStarTier in ['none', 'bronze', 'silver', 'gold']) &&
                               (!('code' in request.resource.data) || (request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{6}$'))) &&
                               (!('friendUids' in request.resource.data) || (request.resource.data.friendUids is list && request.resource.data.friendUids.size() <= 200)) &&
                               request.resource.data.streak is int &&
                               request.resource.data.streak >= 0 &&
                               request.resource.data.streakDate is string &&
                               request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId) && isNonGuest();
    }

    // 1-per-day motivational nudges/congrats between accepted friends
    match /nudges/{nudgeId} {
      allow read, delete: if isNonGuest() && resource.data.toUid == request.auth.uid;
      allow create: if isNonGuest() &&
                       hasOnlyAllowedFields(['fromUid', 'toUid', 'fromName', 'tier', 'senderTheme', 'messageIndex', 'date', 'createdAt']) &&
                       hasRequiredFields(['fromUid', 'toUid', 'fromName', 'tier', 'messageIndex', 'date', 'createdAt']) &&
                       request.resource.data.fromUid == request.auth.uid &&
                       request.resource.data.toUid is string &&
                       request.resource.data.toUid != request.auth.uid &&
                       isAcceptedFriend(request.resource.data.toUid) &&
                       request.resource.data.fromName is string &&
                       request.resource.data.fromName.size() >= 1 &&
                       request.resource.data.fromName.size() <= 24 &&
                       request.resource.data.tier in ['none', 'bronze', 'silver', 'gold'] &&
                       (!('senderTheme' in request.resource.data) || request.resource.data.senderTheme in ['dark', 'astrology', 'tarot', 'win95', 'satc']) &&
                       request.resource.data.messageIndex is int &&
                       request.resource.data.messageIndex >= 0 &&
                       request.resource.data.date is string &&
                       nudgeId == request.auth.uid + '_' + request.resource.data.toUid + '_' + request.resource.data.date &&
                       request.resource.data.createdAt is timestamp;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
