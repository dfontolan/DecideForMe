rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Firebase Auth UID, including anonymous/guest, Google Sign-In, & username/password)
    // Fields:
    //   - state: map (required, max 50 top-level keys) - serialized DecideForMe app state
    //   - updatedAt: timestamp (required) - last sync timestamp
    //   - accountType: string (optional, 'guest' | 'google' | 'username') - authentication provider type
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (covers Google Sign-In and Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the document by document ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate that all required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function isValidUserState(data) {
      return hasOnlyAllowedFields(['state', 'updatedAt', 'accountType']) &&
             hasRequiredFields(['state', 'updatedAt']) &&
             data.state is map &&
             data.state.keys().size() <= 50 &&
             data.updatedAt is timestamp &&
             (!('accountType' in data) || (data.accountType is string && data.accountType in ['guest', 'google', 'username']));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserState(request.resource.data);
      allow update: if isOwner(userId) && isValidUserState(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
